# ---------------------------------------------------------------- images
# Set these to pull release images from GitHub Container Registry.
#PDFSIGN_IMAGE=ghcr.io/voxel07/pdf
#PDFSIGN_BOT_IMAGE=ghcr.io/voxel07/pdf-bot
#PDFSIGN_CALENDAR_IMAGE=ghcr.io/voxel07/pdf-calendar
#PDFSIGN_TAG=0.5.3

# ---------------------------------------------------------------- pdfsign server
# Public base URL (used for signing links and the OIDC redirect: <PUBLIC_URL>/auth/callback)
PUBLIC_URL=https://sign.example.com

# authentik OAuth2/OpenID provider. Copy the exact HTTPS issuer from discovery.
OIDC_ISSUER=https://auth.example.com/application/o/pdfsign/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
# authentik groups mapped to app roles
OIDC_ADMIN_GROUP=pdfsign-admins
OIDC_STAFF_GROUP=pdfsign-staff

# wrong-name attempts before a signing link is locked
MAX_NAME_ATTEMPTS=10
# set to true to omit the audit-trail page in generated PDFs
#NO_AUDIT_PAGE=true

# Exact reverse-proxy peer IPs or narrow CIDRs trusted to append X-Forwarded-For.
# Empty = always use the connecting address.
#TRUSTED_PROXIES=127.0.0.1/32

# Explicit exceptions for private or HTTP DocuSeal API/file hosts. Use exact origins.
#DOCUSEAL_TRUSTED_ORIGINS=https://docuseal.internal.example,http://docuseal:3000

# timezone for backup schedules
TZ=Europe/Berlin
# Private host folder for backups (mounted at /backups, writable by PDFSIGN_UID/GID)
BACKUP_HOST_DIR=./backups

# host user owning ./data, ./export and the backup folder (id -u / id -g)
PDFSIGN_UID=1000
PDFSIGN_GID=1000
# host port binding
PDFSIGN_BIND=127.0.0.1:8080

# ---------------------------------------------------------------- Discord bot
DISCORD_TOKEN=
# limit server commands to one guild; empty = all servers the bot joins
DISCORD_GUILD_ID=
# Signing API token generated in the web UI (API & export -> Generate token).
# Leave blank to run only the event commands when EVENTS_ENABLED=true.
PDFSIGN_API_KEY=
# template slugs
EVENT_TEMPLATE=event-waiver
EQUIPMENT_TEMPLATE=equipment
# role ids allowed to use staff commands (comma separated). When set, only these roles count;
# when empty, the Manage Server permission is required
ADMIN_ROLE_IDS=
WATCH_SCHEDULED_EVENTS=true
NOTIFY_CHANNEL_ID=

# ---------------------------------------------------------------- Event scheduling (optional)
# Enables /admin/events, the event API and calendar feeds backed by the calendar service.
# The bot uses PUBLIC_URL above for its authenticated event links.
EVENTS_ENABLED=false
# Optional authentik group for members who can view events and RSVP.
#OIDC_EVENT_GROUP=pdfsign-events
# Shared service token (32–128 URL-safe characters). Set the same value in both services.
#CALENDAR_PDFSIGN_TOKEN=
# Defaults to the calendar Compose service. Set this to an accessible origin for a separate deployment.
#CALENDAR_URL=http://calendar:3090
# Set these when running the calendar profile. Use distinct secrets for all three tokens.
#CALENDAR_ADMIN_TOKEN=
#CALENDAR_FEED_TOKEN=
#CALENDAR_PUBLIC_URL=https://calendar.example.com
# Sign-in for the calendar web app: a separate authentik provider with the redirect URI
# <CALENDAR_PUBLIC_URL>/auth/callback. See calendar/README.md.
#CALENDAR_OIDC_ISSUER=https://auth.example.com/application/o/calendar/
#CALENDAR_OIDC_CLIENT_ID=
#CALENDAR_OIDC_CLIENT_SECRET=
#CALENDAR_OIDC_GROUP=pdfsign-events
#CALENDAR_OIDC_ADMIN_GROUP=pdfsign-admins
