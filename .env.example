# ---------------------------------------------------------------- images
# Set these to pull release images from GitHub Container Registry.
#PDFSIGN_IMAGE=ghcr.io/voxel07/pdf
#PDFSIGN_BOT_IMAGE=ghcr.io/voxel07/pdf-bot
#PDFSIGN_TAG=0.5.3

# ---------------------------------------------------------------- pdfsign server
# Public base URL (used for signing links and the OIDC redirect: <PUBLIC_URL>/auth/callback)
PUBLIC_URL=https://sign.example.com

# authentik OAuth2/OpenID provider (Applications -> Providers -> OAuth2/OpenID)
OIDC_ISSUER=https://auth.example.com/application/o/pdfsign/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
# authentik groups mapped to app roles
OIDC_ADMIN_GROUP=pdfsign-admins
OIDC_STAFF_GROUP=pdfsign-staff

# wrong-name attempts before a signing link is locked
MAX_NAME_ATTEMPTS=10
# set to true to omit the audit-trail page in generated PDFs
#NO_AUDIT_PAGE=true

# proxies whose X-Forwarded-For header is trusted (comma separated IPs / CIDRs);
# default: loopback and private networks. Empty = always use the connecting address.
#TRUSTED_PROXIES=127.0.0.1/32,172.16.0.0/12

# timezone for backup schedules
TZ=Europe/Berlin
# host folder for backups (mounted at /backups in the container)
BACKUP_HOST_DIR=./backups

# host user owning ./data, ./export and the backup folder (id -u / id -g)
PDFSIGN_UID=1000
PDFSIGN_GID=1000
# host port binding
PDFSIGN_BIND=127.0.0.1:8080

# ---------------------------------------------------------------- Discord bot
DISCORD_TOKEN=
# limit server commands to one guild; empty = all servers the bot joins
DISCORD_GUILD_ID=
# API token generated in the web UI (API & export -> Generate token)
PDFSIGN_API_KEY=
# template slugs
EVENT_TEMPLATE=event-waiver
EQUIPMENT_TEMPLATE=equipment
# role ids allowed to use staff commands (comma separated). When set, only these roles count;
# when empty, the Manage Server permission is required
ADMIN_ROLE_IDS=
WATCH_SCHEDULED_EVENTS=true
NOTIFY_CHANNEL_ID=
