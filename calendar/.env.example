CALENDAR_ADMIN_TOKEN=
CALENDAR_FEED_TOKEN=
# Optional. Set the same distinct token in pdfsign to enable its event integration.
# CALENDAR_PDFSIGN_TOKEN=
# CALENDAR_VOLUME_NAME=calendar_calendar-data
# CALENDAR_NAME=Calendar
# Required for authentik sign-in: the origin the browser uses, without a path.
CALENDAR_PUBLIC_URL=https://calendar.example.com
# authentik OAuth2/OpenID provider for the web app. Redirect URI: <CALENDAR_PUBLIC_URL>/auth/callback
CALENDAR_OIDC_ISSUER=https://auth.example.com/application/o/calendar/
CALENDAR_OIDC_CLIENT_ID=
CALENDAR_OIDC_CLIENT_SECRET=
# CALENDAR_OIDC_SCOPES=openid profile email
# Only members of this group can sign in. Empty = anyone authentik lets through.
# CALENDAR_OIDC_GROUP=calendar-users
# Only members of this group can change the shared calendar in the web app. Empty = everyone who signs in.
# CALENDAR_OIDC_ADMIN_GROUP=calendar-admins
# CALENDAR_BIND=127.0.0.1
# CALENDAR_HOST_PORT=3090
# CALENDAR_WEBHOOK_URL=https://automation.example.com/hooks/calendar
# CALENDAR_WEBHOOK_BEARER_TOKEN=
# CALENDAR_WEBHOOK_SECRET=
